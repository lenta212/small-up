<PanelContainer xmlns="https://spacestation14.io"
                xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                HorizontalExpand="True"
                Margin="0 0 0 8">
    <PanelContainer.PanelOverride>
        <gfx:StyleBoxFlat BackgroundColor="#151D20"
                          BorderColor="#344A52"
                          BorderThickness="1" />
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  Margin="10 8">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Name="VesselName"
                       Access="Public"
                       StyleClasses="PdaListingTitle"
                       HorizontalExpand="True" />
                <Label Name="VesselMeta"
                       Access="Public"
                       StyleClasses="PdaSectionHint"
                       HorizontalExpand="True"
                       Margin="0 2 0 0" />
            </BoxContainer>
            <Label Name="Price"
                   Access="Public"
                   StyleClasses="PdaSubsectionTitle"
                   MinWidth="110"
                   Align="Right"
                   VerticalAlignment="Center"
                   Margin="8 0 0 0" />
        </BoxContainer>

        <RichTextLabel Name="VesselDescription"
                       Access="Public"
                       HorizontalExpand="True"
                       Margin="0 8 0 8" />

        <RichTextLabel Name="Availability"
                       Access="Public"
                       HorizontalExpand="True"
                       Modulate="#82969C"
                       Margin="0 0 0 8" />

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Control HorizontalExpand="True" />
            <Button Name="Guidebook"
                    Access="Public"
                    Text="{Loc 'shipyard-console-guidebook'}"
                    MinWidth="120"
                    Margin="0 0 8 0" />
            <controls:ConfirmButton Name="Purchase"
                                    Access="Public"
                                    Text="{Loc 'shipyard-console-purchase-available'}"
                                    ConfirmationText="{Loc 'shipyard-console-confirm-purchase-generic'}"
                                    StyleClasses="ButtonColorGreen"
                                    MinWidth="150" />
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
