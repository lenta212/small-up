<cartridges:AppraisalUiFragment xmlns:cartridges="clr-namespace:Content.Client._NF.CartridgeLoader.Cartridges"
                                xmlns="https://spacestation14.io">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True">
        <Label Text="{Loc 'appraisal-program-name'}"
               StyleClasses="PdaScreenTitle" />
        <Label Text="{Loc 'appraisal-hint'}"
               StyleClasses="PdaSectionHint"
               Margin="0 1 0 8" />

        <PanelContainer Name="HeaderPanel"
                        StyleClasses="PdaSectionPanel"
                        HorizontalExpand="True"
                        SetHeight="34">
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True"
                          Margin="8 4"
                          SeparationOverride="8">
                <Label SizeFlagsStretchRatio="3" HorizontalExpand="True"
                       StyleClasses="PdaSectionTitle" Text="{Loc 'appraisal-label-name'}" />
                <Label SizeFlagsStretchRatio="1" HorizontalExpand="True" Align="Right"
                       StyleClasses="PdaSectionTitle" Text="{Loc 'appraisal-label-price'}" />
            </BoxContainer>
        </PanelContainer>

        <ScrollContainer Name="ScrollContainer"
                         HorizontalExpand="True"
                         VerticalExpand="True"
                         HScrollEnabled="False"
                         Margin="0 6 0 0">
            <BoxContainer Orientation="Vertical"
                          Name="AppraisedItemContainer"
                          HorizontalExpand="True"
                          VerticalAlignment="Top">
                <Label Name="EmptyLabel"
                       Text="{Loc 'appraisal-empty'}"
                       StyleClasses="PdaSectionHint"
                       Align="Center"
                       Margin="8 18" />
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</cartridges:AppraisalUiFragment>
