<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'comp-ringer-ui-menu-title'}"
               MinSize="500 260"
               SetSize="520 270">
    <BoxContainer Orientation="Vertical"
                  VerticalExpand="True"
                  HorizontalExpand="True"
                  Margin="8">
        <Label Name="RingtoneTitle"
               Text="{Loc 'comp-ringer-ui-menu-title'}"
               StyleClasses="UiTextTitle"
               FontColorOverride="#E2ECEF" />
        <Label Name="RingtoneHint"
               Text="{Loc 'comp-ringer-ui-note-hint'}"
               StyleClasses="UiTextMuted"
               FontColorOverride="#82969C"
               Margin="0 1 0 8" />

        <PanelContainer StyleClasses="UiSurfaceSection"
                        HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="10 8">
                <Label Name="RingtoneSequenceTitle"
                       Text="{Loc 'comp-ringer-ui-sequence-title'}"
                       StyleClasses="UiTextSection"
                       FontColorOverride="#72C2D0"
                       Margin="0 0 0 6" />
                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True"
                              SeparationOverride="5">
                    <Label Text="♪"
                           StyleClasses="PdaSettingsChevron"
                           FontColorOverride="#72C2D0"
                           SetWidth="24"
                           Align="Center" />
                    <LineEdit Name="RingerNoteOneInput" Access="Public" SetWidth="50" />
                    <Label Text="–" FontColorOverride="#DCE8EB" Align="Center" />
                    <LineEdit Name="RingerNoteTwoInput" Access="Public" SetWidth="50" />
                    <Label Text="–" FontColorOverride="#DCE8EB" Align="Center" />
                    <LineEdit Name="RingerNoteThreeInput" Access="Public" SetWidth="50" />
                    <Label Text="–" FontColorOverride="#DCE8EB" Align="Center" />
                    <LineEdit Name="RingerNoteFourInput" Access="Public" SetWidth="50" />
                    <Label Text="–" FontColorOverride="#DCE8EB" Align="Center" />
                    <LineEdit Name="RingerNoteFiveInput" Access="Public" SetWidth="50" />
                    <Label Text="–" FontColorOverride="#DCE8EB" Align="Center" />
                    <LineEdit Name="RingerNoteSixInput" Access="Public" SetWidth="50" />
                </BoxContainer>
                <Label Name="RingtoneStatusLabel"
                       Access="Public"
                       Text="{Loc 'comp-ringer-ui-status-ready'}"
                       StyleClasses="UiTextMuted"
                       FontColorOverride="#82969C"
                       Margin="0 7 0 0"/>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      HorizontalAlignment="Right"
                      Margin="0 10 0 0"
                      SeparationOverride="6">
            <Button Name="TestRingerButton"
                    Access="Public"
                    Text="{Loc 'comp-ringer-ui-test-ringtone-button'}"
                    MinWidth="110" />
            <Button Name="SetRingerButton"
                    Access="Public"
                    Text="{Loc 'comp-ringer-ui-set-ringtone-button'}"
                    MinWidth="110" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
