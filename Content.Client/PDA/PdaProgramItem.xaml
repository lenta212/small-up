<pda:PdaProgramItem HorizontalExpand="True" MinHeight="76" Margin="0 0 0 6"
                    xmlns:pda="clr-namespace:Content.Client.PDA"
                    xmlns="https://spacestation14.io">
    <PanelContainer Name="Panel"/>
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Margin="10 8">
        <BoxContainer Orientation="Vertical" VerticalExpand="True" MinWidth="52" MaxWidth="52">
            <AnimatedTextureRect HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 VerticalExpand="True"
                                 Name="Icon"
                                 Access="Public"/>
        </BoxContainer>
        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="10 0 0 0">
            <Label Name="ProgramName"
                   Access="Public"
                   StyleClasses="PdaProgramTitle"
                   FontColorOverride="#DCE8EB"
                   VerticalExpand="True"
                   VerticalAlignment="Center"/>
            <BoxContainer HorizontalExpand="True" SetHeight="28">
                <Control HorizontalExpand="True"/>
                <Button Name="InstallButton"
                        Access="Public"
                        Visible="False"
                        MinWidth="116"
                        HorizontalAlignment="Right"
                        VerticalExpand="True"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</pda:PdaProgramItem>
