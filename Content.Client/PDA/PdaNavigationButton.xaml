<pda:PdaNavigationButton xmlns="https://spacestation14.io" xmlns:pda="clr-namespace:Content.Client.PDA">
    <PanelContainer Name="Background"/>
    <AnimatedTextureRect Margin="0 0 0 2"
                         Visible="False"
                         Name="Icon"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
    <Label Visible="True"
           Name="Label"
           StyleClasses="PdaNavigationText"
           FontColorOverride="#DCE8EB"
           Margin="10 0 10 2"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>
</pda:PdaNavigationButton>
