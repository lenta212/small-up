<cartridges:NewsReaderUiFragment xmlns:cartridges="clr-namespace:Content.Client.CartridgeLoader.Cartridges"
                                 xmlns="https://spacestation14.io"
                                 xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
                                 Orientation="Vertical"
                                 HorizontalExpand="True"
                                 VerticalExpand="True">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 8">
        <Button Name="Prev"
                MinWidth="96"
                Disabled="True"
                Text="{Loc 'news-read-ui-prev-text'}"
                ToolTip="{Loc 'news-read-ui-prev-tooltip'}"
                Access="Public"/>
        <Control HorizontalExpand="True"/>
        <Button Name="Next"
                MinWidth="96"
                Disabled="True"
                Text="{Loc 'news-read-ui-next-text'}"
                ToolTip="{Loc 'news-read-ui-next-tooltip'}"/>
    </BoxContainer>

    <PanelContainer StyleClasses="PdaSectionPanel" HorizontalExpand="True" Margin="0 0 0 8">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="10 7">
            <Label Name="PageName"
                   StyleClasses="PdaSubsectionTitle"
                   HorizontalExpand="True"
                   ClipText="True"/>
            <Label Name="PageNum"
                   StyleClasses="PdaSectionHint"
                   VerticalAlignment="Center"
                   Margin="10 0 0 0"/>
        </BoxContainer>
    </PanelContainer>

    <PanelContainer StyleClasses="PdaSectionPanel" HorizontalExpand="True" VerticalExpand="True">
        <ScrollContainer Name="PageTextScroll"
                         HScrollEnabled="False"
                         HorizontalExpand="True"
                         VerticalExpand="True">
            <RichTextLabel Name="PageText" Margin="10 8" VerticalAlignment="Top"/>
        </ScrollContainer>
    </PanelContainer>

    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 8 0 0">
        <Button Name="NotificationSwitch"
                ToolTip="{Loc news-reader-ui-mute-tooltip}"
                MinWidth="120"/>
        <RichTextLabel Name="ShareTime" VerticalAlignment="Center" Margin="8 0"/>
        <customControls:VSeparator Margin="2 0"/>
        <RichTextLabel Name="Author"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       HorizontalExpand="True"
                       Margin="8 0 0 0"/>
    </BoxContainer>
</cartridges:NewsReaderUiFragment>
