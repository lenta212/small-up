<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:fireUi="clr-namespace:Content.Client._Mono.FireControl.UI"
                      xmlns:shuttleUi="clr-namespace:Content.Client.Shuttles.UI"
                      xmlns:shields="clr-namespace:Content.Client._Crescent.ShipShields.UI"
                      xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'gunnery-window-title'}"
                      Resizable="True"
                      SetSize="1100 760"
                      MinSize="760 520">
    <LayoutContainer Name="ConsoleRoot"
                     HorizontalExpand="True"
                     VerticalExpand="True">
        <PanelContainer Name="ConsoleSurface"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        Margin="0 8 0 2">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="2"
                                       BorderColor="#30464A"
                                       BackgroundColor="#0B1013"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Name="RootBox"
                          Orientation="Horizontal"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Margin="8">
                <PanelContainer Name="RadarContainer"
                                HorizontalExpand="True"
                                VerticalExpand="True"
                                Margin="0 0 8 0">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BorderThickness="1"
                                               BorderColor="#294249"
                                               BackgroundColor="#070B0D"/>
                    </PanelContainer.PanelOverride>
                    <LayoutContainer HorizontalExpand="True"
                                     VerticalExpand="True"
                                     Margin="2">
                        <fireUi:FireControlNavControl Name="NavRadar"
                                                      MouseFilter="Stop"
                                                      HorizontalExpand="True"
                                                      VerticalExpand="True"
                                                      VerticalAlignment="Stretch"/>
                    </LayoutContainer>
                </PanelContainer>

                <PanelContainer VerticalExpand="True"
                                HorizontalExpand="False"
                                MinWidth="300"
                                MaxWidth="300">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BorderThickness="1"
                                               BorderColor="#304B50"
                                               BackgroundColor="#0D1417"/>
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HorizontalExpand="True"
                                     VerticalExpand="True"
                                     HScrollEnabled="False"
                                     VScrollEnabled="True"
                                     ReserveScrollbarSpace="True">
                        <BoxContainer Name="ControlsBox"
                                      Orientation="Vertical"
                                      HorizontalAlignment="Stretch"
                                      HorizontalExpand="True"
                                      VerticalAlignment="Top"
                                      MinWidth="274"
                                      MaxWidth="274"
                                      Margin="8 2 8 10">
                            <shuttleUi:ShuttleConsoleSectionHeader Text="{Loc 'gunnery-window-title'}"/>
                            <PanelContainer HorizontalExpand="True"
                                            Margin="8 4 8 8">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BorderThickness="1"
                                                           BorderColor="#24383D"
                                                           BackgroundColor="#080D0F"/>
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Vertical"
                                              HorizontalExpand="True"
                                              Margin="8 6"
                                              SeparationOverride="5">
                                    <Label Name="ServerStatus"
                                           Text="{Loc 'gunnery-window-disconnected'}"
                                           HorizontalAlignment="Center"
                                           HorizontalExpand="True"
                                           FontColorOverride="#FF5864"/>
                                    <shuttleUi:ShuttleConsoleButton Name="RefreshButton"
                                                                    Access="Public"
                                                                    HorizontalExpand="True"
                                                                    MinHeight="34">
                                        <BoxContainer Orientation="Horizontal"
                                                      HorizontalAlignment="Center"
                                                      SeparationOverride="8">
                                            <shuttleUi:ShuttleConsoleIcon Kind="Refresh"
                                                                           MinSize="20 20"/>
                                            <Label Text="{Loc admin-logs-refresh}"
                                                   FontColorOverride="#D7E5E3"/>
                                        </BoxContainer>
                                    </shuttleUi:ShuttleConsoleButton>
                                </BoxContainer>
                            </PanelContainer>

                            <PanelContainer Name="ShieldPanel"
                                            Visible="False"
                                            HorizontalExpand="True"
                                            Margin="8 0 8 8">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BorderThickness="1"
                                                           BorderColor="#385266"
                                                           BackgroundColor="#0E171C"/>
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Vertical"
                                              HorizontalExpand="True"
                                              Margin="8 6">
                                    <Label Text="{Loc 'gunnery-shield-label'}"
                                           FontColorOverride="#72BDE8"/>
                                    <shields:ShipShieldBar Name="ShieldBar"
                                                           HorizontalExpand="True"
                                                           MinHeight="16"/>
                                </BoxContainer>
                            </PanelContainer>

                            <shuttleUi:ShuttleCombatTelemetryPanel Name="CombatTelemetry"/>

                            <shuttleUi:ShuttleConsoleSectionHeader Name="WeaponsLabel"
                                                                   Text="{Loc 'gunnery-guns'}"/>
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          Margin="8 4 8 3"
                                          SeparationOverride="4">
                                <shuttleUi:ShuttleConsoleButton Name="SelectAllButton"
                                                                Access="Public"
                                                                Text="{Loc 'gunnery-select-all'}"
                                                                TextAlign="Center"
                                                                HorizontalExpand="True"
                                                                MinHeight="34"/>
                                <shuttleUi:ShuttleConsoleButton Name="UnselectAllButton"
                                                                Access="Public"
                                                                Text="{Loc 'gunnery-unselect-all'}"
                                                                TextAlign="Center"
                                                                HorizontalExpand="True"
                                                                MinHeight="34"/>
                            </BoxContainer>
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          Margin="8 2 8 7"
                                          SeparationOverride="4">
                                <shuttleUi:ShuttleConsoleButton Name="SelectBallisticButton"
                                                                Access="Public"
                                                                Text="{Loc 'gunnery-select-ballistic'}"
                                                                TextAlign="Center"
                                                                HorizontalExpand="True"
                                                                MinHeight="34"/>
                                <shuttleUi:ShuttleConsoleButton Name="SelectEnergyButton"
                                                                Access="Public"
                                                                Text="{Loc 'gunnery-select-energy'}"
                                                                TextAlign="Center"
                                                                HorizontalExpand="True"
                                                                MinHeight="34"/>
                                <shuttleUi:ShuttleConsoleButton Name="SelectMissileButton"
                                                                Access="Public"
                                                                Text="{Loc 'gunnery-select-missiles'}"
                                                                TextAlign="Center"
                                                                HorizontalExpand="True"
                                                                MinHeight="34"/>
                            </BoxContainer>

                            <shuttleUi:ShuttleConsoleSectionHeader Text="{Loc 'gunnery-radar-overlays'}"/>
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          Margin="8 4 8 8"
                                          SeparationOverride="5">
                                <shuttleUi:ShuttleConsoleButton Name="IFFToggle"
                                                                Access="Public"
                                                                ToggleMode="True"
                                                                HorizontalExpand="True"
                                                                MinHeight="36">
                                    <BoxContainer Orientation="Horizontal"
                                                  HorizontalAlignment="Center"
                                                  SeparationOverride="8">
                                        <shuttleUi:ShuttleConsoleIcon Kind="Iff"
                                                                       MinSize="20 20"/>
                                        <Label Text="{Loc 'shuttle-console-iff-toggle'}"
                                               FontColorOverride="#D7E5E3"/>
                                    </BoxContainer>
                                </shuttleUi:ShuttleConsoleButton>
                                <shuttleUi:ShuttleConsoleButton Name="DockToggle"
                                                                Access="Public"
                                                                ToggleMode="True"
                                                                HorizontalExpand="True"
                                                                MinHeight="36">
                                    <BoxContainer Orientation="Horizontal"
                                                  HorizontalAlignment="Center"
                                                  SeparationOverride="8">
                                        <shuttleUi:ShuttleConsoleIcon Kind="Docking"
                                                                       MinSize="20 20"/>
                                        <Label Text="{Loc 'shuttle-console-dock-toggle'}"
                                               FontColorOverride="#D7E5E3"/>
                                    </BoxContainer>
                                </shuttleUi:ShuttleConsoleButton>
                            </BoxContainer>

                            <shuttleUi:ShuttleConsoleSectionHeader Text="{Loc 'gunnery-weapon-list'}"/>
                            <PanelContainer HorizontalExpand="True"
                                            Margin="8 4 8 8">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BorderThickness="1"
                                                           BorderColor="#24383D"
                                                           BackgroundColor="#080D0F"/>
                                </PanelContainer.PanelOverride>
                                <BoxContainer Name="ControllablesBox"
                                              Orientation="Vertical"
                                              HorizontalExpand="True"
                                              Margin="4 5"/>
                            </PanelContainer>
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>
        <shuttleUi:ShuttleConsoleCrtOverlay Name="CrtOverlay"
                                             HorizontalExpand="True"
                                             VerticalExpand="True"/>
    </LayoutContainer>
</controls:FancyWindow>
