<controls:FancyWindow xmlns="https://spacestation14.io" xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'telecom-log-console-title'}" MinSize="720 480">
  <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4">
    <BoxContainer SeparationOverride="4">
      <OptionButton Name="Map" MinWidth="180"/>
      <OptionButton Name="Channel" MinWidth="240"/>
      <Button Name="Search" Text="{Loc 'telecom-log-console-search'}"/>
    </BoxContainer>
    <LineEdit Name="Frequency" MinWidth="420" PlaceHolder="{Loc 'telecom-log-console-frequency'}"/>
    <LineEdit Name="Speaker" MinWidth="420" PlaceHolder="{Loc 'telecom-log-console-name'}"/>
    <LineEdit Name="Words" MinWidth="420" PlaceHolder="{Loc 'telecom-log-console-words'}"/>
    <BoxContainer SeparationOverride="4">
      <LineEdit Name="From" MinWidth="205" PlaceHolder="{Loc 'telecom-log-console-from'}"/>
      <LineEdit Name="To" MinWidth="205" PlaceHolder="{Loc 'telecom-log-console-to'}"/>
    </BoxContainer>
    <LineEdit Name="Password" MinWidth="420" PlaceHolder="{Loc 'telecom-log-console-password'}"/>
    <RichTextLabel Name="Status"/>
    <RichTextLabel Name="Entries" VerticalExpand="True"/>
  </BoxContainer>
</controls:FancyWindow>
