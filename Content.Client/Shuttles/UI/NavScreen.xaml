<controls:BoxContainer Visible="False"
                       HorizontalExpand="True"
                       VerticalExpand="True"
                       xmlns:controls="https://spacestation14.io"
                       xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
                       xmlns:shields="clr-namespace:Content.Client._Crescent.ShipShields.UI"
                       xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <controls:PanelContainer HorizontalExpand="True" VerticalExpand="True" Margin="0 0 8 0">
        <controls:PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BorderThickness="1"
                                   BorderColor="#294249"
                                   BackgroundColor="#070B0D"/>
        </controls:PanelContainer.PanelOverride>
        <controls:LayoutContainer HorizontalExpand="True" VerticalExpand="True" Margin="2">
            <ui:ShuttleNavControl Name="NavRadar"
                                  MouseFilter="Stop"
                                  VerticalAlignment="Stretch"
                                  VerticalExpand="True"
                                  HorizontalExpand="True"/>
        </controls:LayoutContainer>
    </controls:PanelContainer>
    <controls:PanelContainer VerticalExpand="True"
                             HorizontalExpand="False"
                             MinWidth="286"
                             MaxWidth="286">
        <controls:PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BorderThickness="1"
                                   BorderColor="#304B50"
                                   BackgroundColor="#0D1417"/>
        </controls:PanelContainer.PanelOverride>
        <controls:ScrollContainer VerticalExpand="True"
                                  HorizontalExpand="True"
                                  HScrollEnabled="False"
                                  VScrollEnabled="True"
                                  ReserveScrollbarSpace="True">
            <controls:BoxContainer Name="RightDisplayNav"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Stretch"
                                   VerticalExpand="True"
                                   MinWidth="260"
                                   MaxWidth="260"
                                   Margin="8 2 8 10"
                                   Orientation="Vertical">
                <ui:ShuttleConsoleSectionHeader Name="NavDisplayLabel"
                                                Text="{controls:Loc 'shuttle-console-display-label'}"/>
                <controls:PanelContainer HorizontalExpand="True" Margin="8 4 8 8">
                    <controls:PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BorderThickness="1"
                                               BorderColor="#24383D"
                                               BackgroundColor="#080D0F"/>
                    </controls:PanelContainer.PanelOverride>
                    <controls:GridContainer Columns="2"
                                            HorizontalAlignment="Stretch"
                                            HorizontalExpand="True"
                                            Margin="8"
                                            Name="ReadonlyDisplay">
                        <controls:Label Text="{controls:Loc 'shuttle-console-designation'}"
                                        FontColorOverride="#829597"/>
                        <controls:Label Name="ShuttleDesignation"
                                        Text="{controls:Loc 'shuttle-console-designation-unknown'}"
                                        HorizontalExpand="True"
                                        Align="Right"
                                        FontColorOverride="#A9E3C7"/>
                        <controls:Label Text="{controls:Loc 'shuttle-console-position'}"
                                        FontColorOverride="#829597"/>
                        <controls:Label Name="GridPosition"
                                        Text="0.0, 0.0 m"
                                        HorizontalExpand="True"
                                        Align="Right"
                                        FontColorOverride="#A9E3C7"/>
                        <controls:Label Text="{controls:Loc 'shuttle-console-orientation'}"
                                        FontColorOverride="#829597"/>
                        <controls:Label Name="GridOrientation"
                                        Text="0.0°"
                                        HorizontalExpand="True"
                                        Align="Right"
                                        FontColorOverride="#A9E3C7"/>
                        <controls:Label Text="{controls:Loc 'shuttle-console-linear-velocity'}"
                                        FontColorOverride="#829597"/>
                        <controls:Label Name="GridLinearVelocity"
                                        Text="0.0, 0.0 m/s"
                                        HorizontalExpand="True"
                                        Align="Right"
                                        FontColorOverride="#A9E3C7"/>
                        <controls:Label Text="{controls:Loc 'shuttle-console-angular-velocity'}"
                                        FontColorOverride="#829597"/>
                        <controls:Label Name="GridAngularVelocity"
                                        Text="0.0°/s"
                                        HorizontalExpand="True"
                                        Align="Right"
                                        FontColorOverride="#A9E3C7"/>
                    </controls:GridContainer>
                </controls:PanelContainer>

                <controls:PanelContainer Name="ShieldPanel"
                                         Visible="False"
                                         HorizontalExpand="True"
                                         Margin="8 0 8 8">
                    <controls:PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BorderThickness="1"
                                               BorderColor="#385266"
                                               BackgroundColor="#0E171C"/>
                    </controls:PanelContainer.PanelOverride>
                    <controls:BoxContainer Orientation="Vertical"
                                           HorizontalExpand="True"
                                           Margin="8 6">
                        <controls:Label Text="{controls:Loc 'shuttle-console-shield-label'}"
                                        FontColorOverride="#72BDE8"/>
                        <shields:ShipShieldBar Name="ShieldBar"
                                               HorizontalExpand="True"
                                               MinHeight="16"/>
                    </controls:BoxContainer>
                </controls:PanelContainer>

                <ui:ShuttleCombatTelemetryPanel Name="CombatTelemetry"/>

                <ui:ShuttleConsoleSectionHeader Name="NavSettingsLabel"
                                                Text="{controls:Loc 'shuttle-console-nav-settings'}"/>
                <controls:BoxContainer Orientation="Vertical"
                                       Margin="8 4 8 8"
                                       SeparationOverride="5">
                    <ui:ShuttleConsoleButton Name="IFFToggle"
                                             TextAlign="Center"
                                             ToggleMode="True"
                                             HorizontalExpand="True"
                                             MinHeight="36">
                        <controls:BoxContainer Orientation="Horizontal"
                                               HorizontalAlignment="Center"
                                               SeparationOverride="8">
                            <ui:ShuttleConsoleIcon Kind="Iff" MinSize="20 20"/>
                            <controls:Label Text="{controls:Loc 'shuttle-console-iff-toggle'}"
                                            FontColorOverride="#D7E5E3"/>
                        </controls:BoxContainer>
                    </ui:ShuttleConsoleButton>
                    <ui:ShuttleConsoleButton Name="IFFShuttleToggle"
                                             TextAlign="Center"
                                             ToggleMode="True"
                                             HorizontalExpand="True"
                                             MinHeight="36">
                        <controls:BoxContainer Orientation="Horizontal"
                                               HorizontalAlignment="Center"
                                               SeparationOverride="8">
                            <ui:ShuttleConsoleIcon Kind="Navigation" MinSize="20 20"/>
                            <controls:Label Text="{controls:Loc 'shuttle-console-iffshuttles-toggle'}"
                                            FontColorOverride="#D7E5E3"/>
                        </controls:BoxContainer>
                    </ui:ShuttleConsoleButton>
                    <ui:ShuttleConsoleButton Name="DockToggle"
                                             TextAlign="Center"
                                             ToggleMode="True"
                                             HorizontalExpand="True"
                                             MinHeight="36">
                        <controls:BoxContainer Orientation="Horizontal"
                                               HorizontalAlignment="Center"
                                               SeparationOverride="8">
                            <ui:ShuttleConsoleIcon Kind="Docking" MinSize="20 20"/>
                            <controls:Label Text="{controls:Loc 'shuttle-console-dock-toggle'}"
                                            FontColorOverride="#D7E5E3"/>
                        </controls:BoxContainer>
                    </ui:ShuttleConsoleButton>

                    <controls:Label Name="DampenerModeStatus"
                                    Text="{controls:Loc 'shuttle-console-inertia-dampener-status-unknown'}"
                                    HorizontalExpand="True"
                                    Margin="0 5 0 0"
                                    FontColorOverride="#A9E3C7"/>
                    <controls:BoxContainer Name="DampenerModeButtons"
                                           Orientation="Horizontal"
                                           Margin="0 2 0 0"
                                           SeparationOverride="3">
                        <ui:ShuttleConsoleButton Name="DampenerOff"
                                                 Text="{controls:Loc 'shuttle-console-inertia-dampener-off'}"
                                                 TextAlign="Center"
                                                 ToggleMode="True"
                                                 HorizontalExpand="True"
                                                 MinWidth="60"/>
                        <ui:ShuttleConsoleButton Name="DampenerOn"
                                                 Text="{controls:Loc 'shuttle-console-inertia-dampener-dampen'}"
                                                 TextAlign="Center"
                                                 ToggleMode="True"
                                                 HorizontalExpand="True"
                                                 MinWidth="60"/>
                        <ui:ShuttleConsoleButton Name="AnchorOn"
                                                 Text="{controls:Loc 'shuttle-console-inertia-dampener-anchor'}"
                                                 TextAlign="Center"
                                                 ToggleMode="True"
                                                 HorizontalExpand="True"
                                                 MinWidth="60"/>
                    </controls:BoxContainer>

                    <controls:BoxContainer Orientation="Vertical"
                                           HorizontalExpand="True"
                                           Name="IffSearchBox"
                                           Margin="0 7 0 0">
                        <controls:Label Text="{controls:Loc 'shuttle-console-iff-search'}"
                                        FontColorOverride="#8FA7A8"/>
                        <controls:LineEdit Name="IffSearchCriteria"
                                           Access="Public"
                                           HorizontalExpand="True"/>
                    </controls:BoxContainer>
                    <controls:BoxContainer Orientation="Vertical"
                                           HorizontalExpand="True"
                                           Name="MaximumIFFDistanceBox"
                                           Margin="0 5 0 0">
                        <controls:Label Text="{controls:Loc 'shuttle-console-maximum-iff-distance'}"
                                        FontColorOverride="#8FA7A8"/>
                        <controls:SliderIntInput Name="MaximumIFFDistanceValue"
                                                 Access="Public"
                                                 MinValue="0"
                                                 MaxValue="30000"
                                                 Value="3000"
                                                 HorizontalExpand="True"/>
                    </controls:BoxContainer>
                    <controls:BoxContainer Orientation="Vertical"
                                           HorizontalExpand="True"
                                           Name="MaximumShuttleSpeedBox"
                                           Margin="0 5 0 0">
                        <controls:Label Text="{controls:Loc 'shuttle-console-maximum-speed'}"
                                        FontColorOverride="#8FA7A8"/>
                        <controls:LineEdit Name="MaximumShuttleSpeedValue"
                                           Access="Public"
                                           PlaceHolder="{controls:Loc 'shuttle-console-maximum-speed-placeholder'}"
                                           HorizontalExpand="True"/>
                        <controls:Label Name="MaximumShuttleSpeedFeedback"
                                        Text="{controls:Loc 'shuttle-console-maximum-speed-unlimited'}"
                                        HorizontalExpand="True"
                                        Margin="1 1 1 0"
                                        FontColorOverride="#829597"/>
                    </controls:BoxContainer>
                </controls:BoxContainer>

                <ui:ShuttleConsoleSectionHeader Text="{controls:Loc 'shuttle-console-network-ports'}"/>
                <controls:PanelContainer HorizontalExpand="True" Margin="8 4 8 8">
                    <controls:PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BorderThickness="1"
                                               BorderColor="#24383D"
                                               BackgroundColor="#080D0F"/>
                    </controls:PanelContainer.PanelOverride>
                    <controls:GridContainer Columns="4"
                                            Rows="2"
                                            HorizontalExpand="True"
                                            HorizontalAlignment="Center"
                                            Name="NetworkPortsBox"
                                            Margin="6">
                        <ui:ShuttleConsoleButton Name="DeviceButton1"
                                                 Text="{controls:Loc 'shuttle-console-device-button-1'}"
                                                 TextAlign="Center"
                                                 ToolTip="{controls:Loc 'shuttle-console-network-connect-tooltip'}"
                                                 SetWidth="54"
                                                 MinHeight="34"/>
                        <ui:ShuttleConsoleButton Name="DeviceButton2"
                                                 Text="{controls:Loc 'shuttle-console-device-button-2'}"
                                                 TextAlign="Center"
                                                 ToolTip="{controls:Loc 'shuttle-console-network-connect-tooltip'}"
                                                 SetWidth="54"
                                                 MinHeight="34"/>
                        <ui:ShuttleConsoleButton Name="DeviceButton3"
                                                 Text="{controls:Loc 'shuttle-console-device-button-3'}"
                                                 TextAlign="Center"
                                                 ToolTip="{controls:Loc 'shuttle-console-network-connect-tooltip'}"
                                                 SetWidth="54"
                                                 MinHeight="34"/>
                        <ui:ShuttleConsoleButton Name="DeviceButton4"
                                                 Text="{controls:Loc 'shuttle-console-device-button-4'}"
                                                 TextAlign="Center"
                                                 ToolTip="{controls:Loc 'shuttle-console-network-connect-tooltip'}"
                                                 SetWidth="54"
                                                 MinHeight="34"/>
                        <ui:ShuttleConsoleButton Name="DeviceButton5"
                                                 Text="{controls:Loc 'shuttle-console-device-button-5'}"
                                                 TextAlign="Center"
                                                 ToolTip="{controls:Loc 'shuttle-console-network-connect-tooltip'}"
                                                 SetWidth="54"
                                                 MinHeight="34"/>
                        <ui:ShuttleConsoleButton Name="DeviceButton6"
                                                 Text="{controls:Loc 'shuttle-console-device-button-6'}"
                                                 TextAlign="Center"
                                                 ToolTip="{controls:Loc 'shuttle-console-network-connect-tooltip'}"
                                                 SetWidth="54"
                                                 MinHeight="34"/>
                        <ui:ShuttleConsoleButton Name="DeviceButton7"
                                                 Text="{controls:Loc 'shuttle-console-device-button-7'}"
                                                 TextAlign="Center"
                                                 ToolTip="{controls:Loc 'shuttle-console-network-connect-tooltip'}"
                                                 SetWidth="54"
                                                 MinHeight="34"/>
                        <ui:ShuttleConsoleButton Name="DeviceButton8"
                                                 Text="{controls:Loc 'shuttle-console-device-button-8'}"
                                                 TextAlign="Center"
                                                 ToolTip="{controls:Loc 'shuttle-console-network-connect-tooltip'}"
                                                 SetWidth="54"
                                                 MinHeight="34"/>
                    </controls:GridContainer>
                </controls:PanelContainer>
            </controls:BoxContainer>
        </controls:ScrollContainer>
    </controls:PanelContainer>
</controls:BoxContainer>
